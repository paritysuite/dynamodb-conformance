<script webc:setup>
  // The synthesised baseline row, for the control strip: its figures are the
  // harness's own health check rather than a competitor's score.
  function baselineOf(standings) { return standings.find((r) => r.baseline) ?? null; }
  // What the real-AWS lanes observed, from the artefact rather than the row.
  function observationOf(summary) {
    return summary?.available ? controlObservation(summary.latest?.groundTruth) : null;
  }
  function splitOf(summary) { return controlSplit(observationOf(summary)); }
  // The gating run's own date, so the label dates the observation rather than
  // the site's latest run, which are the same today but need not be.
  function mainDateOf(summary) { return observationOf(summary)?.mainRun?.runDate ?? null; }
  // The run page to hang the measured date on, when the board's newest run is
  // the run that measured. Most days it is, and then one linked date says both
  // things. When it is not - real AWS runs weekly, the emulators every merge -
  // the measured date belongs to an earlier run, so linking it here would point
  // at a run that did not take the measurement.
  function measuredRunId(summary, latest) {
    return mainDateOf(summary) && mainDateOf(summary) === latest.date ? latest.id : null;
  }
</script>
<section id="results" class="results-section max-w-6xl mx-auto px-6 py-12 sm:py-16">
  <div class="mb-8">
    <div class="results-heading"><div><p class="eyebrow">The conformance board</p><h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Latest results</h2></div><a :href="'/runs/' + $data.conformance.latest.id" class="run-date">Run <time :datetime="$data.conformance.latest.date" @text="dateLabel($data.conformance.latest.date)"></time><span aria-hidden="true">↗</span></a></div>
    <!-- One paragraph, not a methodology lecture: the grade carries the
         verdict, the two figures beside it carry the detail, and the full
         reasoning lives one click away. The old two-paragraph intro existed
         to explain a bar encoding that no longer needs explaining. -->
    <p class="mt-3 text-zinc-600 dark:text-zinc-300 max-w-2xl leading-relaxed">
      <strong>Divergence</strong>: tests answered differently from AWS. <strong>Coverage</strong>: tests implemented.
      Each emulator is scored against its closest matching region.
      <a href="/methodology#grading" class="underline hover:text-brand-700 dark:hover:text-brand-300">How grades are worked out</a>.
    </p>
  </div>

  <!-- The baseline as a status strip, not a graded card. Real DynamoDB scored
       against its own recorded answers must come out at exactly zero, and a
       broken harness could not produce that - so the zero is a live control
       on the pipeline and the anchor for what a clean run looks like. It is
       not a competitor: a grade reads how far a target sits from DynamoDB,
       and grading the yardstick A+ seats it in the band an engine had to
       earn its way into. The strip also carries the run's vitals (suite
       size, date, region health), so the standings below hold only the
       things actually being measured. -->
  <div class="mb-6 grid gap-3 sm:grid-cols-2" webc:if="baselineOf($data.conformance.latest.standings)">
    <!-- The suite and its provenance in one panel. These were two, and between
         them they printed the size twice, the date twice and the region count
         that the Regions panel owns. The size now comes from the run rather
         than the ground-truth observation: the observation is absent whenever
         the summary is, and the old panel rendered a blank where the number
         should be. Which lanes are outstanding stays a question for the
         ground-truth page rather than the front of the board. -->
    <div class="rounded-xl border border-brand-200 dark:border-brand-500/30 bg-brand-50 dark:bg-brand-500/10 px-4 py-3">
      <div class="text-[0.7rem] uppercase tracking-wide font-medium text-brand-700 dark:text-brand-300 mb-1">Suite</div>
      <div class="text-sm font-medium text-zinc-800 dark:text-zinc-100">
        <span class="tnum" @text="formatNumber($data.conformance.latest.suiteSize)"></span> tests · checked against live AWS
      </div>
      <div class="mt-0.5 text-xs leading-snug text-zinc-600 dark:text-zinc-400">
        <span webc:if="mainDateOf($data.summary)">last measured <a webc:if="measuredRunId($data.summary, $data.conformance.latest)" :href="'/runs/' + measuredRunId($data.summary, $data.conformance.latest)" class="underline decoration-dotted underline-offset-2 hover:text-brand-700 dark:hover:text-brand-300 whitespace-nowrap"><time :datetime="mainDateOf($data.summary)" @text="dateLabel(mainDateOf($data.summary))"></time></a><time webc:else class="whitespace-nowrap" :datetime="mainDateOf($data.summary)" @text="dateLabel(mainDateOf($data.summary))"></time><span webc:if="splitOf($data.summary)"> · <span @text="splitOf($data.summary)"></span></span> · </span><a href="/ground-truth" class="underline decoration-dotted underline-offset-2 hover:text-brand-700 dark:hover:text-brand-300">how</a><span webc:if="!measuredRunId($data.summary, $data.conformance.latest)"> · latest run <a :href="'/runs/' + $data.conformance.latest.id" class="underline decoration-dotted underline-offset-2 hover:text-brand-700 dark:hover:text-brand-300 whitespace-nowrap"><time :datetime="$data.conformance.latest.date" @text="dateLabel($data.conformance.latest.date)"></time></a></span>
      </div>
    </div>
    <!-- Region health, panel-shaped: a dropped or unresolved region is named,
         never silently omitted, so an absent region can't read as one that
         agreed. Colour is backed by a word in every case. -->
    <div class="rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/[0.03] px-4 py-3">
      <div class="text-[0.7rem] uppercase tracking-wide font-medium text-zinc-500 dark:text-zinc-400 mb-1">Regions</div>
      <div class="text-sm font-medium text-zinc-800 dark:text-zinc-100">
        <span webc:if="$data.summary.available"><span class="tnum" @text="$data.summary.latest.regions.observed.length"></span> real regions scored</span>
        <span webc:else><span class="tnum" @text="baselineOf($data.conformance.latest.standings).regionLabel?.observed ?? '–'"></span> real regions scored</span>
      </div>
      <div webc:if="$data.summary.available" class="mt-0.5 text-xs leading-snug text-zinc-600 dark:text-zinc-400 space-y-0.5">
        <!-- items-start, not items-center: these lines wrap, and a centred dot
             floats to the middle of the block instead of sitting against the
             region it marks. The em-relative offset drops it onto the first
             line's centre and follows the font size rather than pinning to one. -->
        <div webc:if="$data.summary.latest.regions.unresolved.length" class="flex items-start gap-1.5">
          <span class="h-1.5 w-1.5 mt-[0.4em] rounded-full bg-partial-500 dark:bg-partial-400 shrink-0" aria-hidden="true"></span>
          <span><span class="tnum" @text="$data.summary.latest.regions.unresolved.length"></span> unresolved, still trusted: <span class="font-mono" @text="$data.summary.latest.regions.unresolved.join(', ')"></span></span>
        </div>
        <div webc:if="$data.summary.latest.regions.dropped.length" class="flex items-start gap-1.5">
          <span class="h-1.5 w-1.5 mt-[0.4em] rounded-full bg-fail-500 dark:bg-fail-400 shrink-0" aria-hidden="true"></span>
          <span><span class="tnum" @text="$data.summary.latest.regions.dropped.length"></span> dropped until <span @text="$data.summary.latest.regions.dropped.length === 1 ? 'it returns' : 'they return'"></span>: <span class="font-mono" @text="$data.summary.latest.regions.dropped.join(', ')"></span></span>
        </div>
        <div webc:if="!$data.summary.latest.regions.unresolved.length && !$data.summary.latest.regions.dropped.length">all observed regions resolved</div>
      </div>
    </div>
  </div>

  <!-- Region health lives in the status strip above; this block is purely
       how to read a grade. -->
  <details class="grade-guide mb-6">
    <summary>How to read these results <span>Grades, coverage &amp; movement</span></summary>
    <div class="pt-4 space-y-3">
    <!-- The complete criteria, because a letter a reader cannot reproduce is a
         verdict asked to be taken on trust. The 5% and 25% boundaries carry
         over the numbers of the board's long-published colour bands, which sat
         on correctness rather than divergence; the rest is new. -->
    <div class="space-y-1.5 text-xs text-zinc-500 dark:text-zinc-400">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <span webc:for="g of $data.gradeLegend" class="inline-flex items-center gap-1.5"><span :class="'grade-chip grade-' + g.band + ' text-[0.65rem] !min-w-0 !px-1.5 !py-0.5'" @text="g.letter"></span><span @text="g.bound"></span></span>
        <span class="hidden sm:inline text-zinc-300 dark:text-zinc-700" aria-hidden="true">|</span>
        <span class="inline-flex items-center gap-x-5">
          <span class="inline-flex items-center gap-1"><span class="move-improved font-medium">▼</span> diverged less</span>
          <span class="inline-flex items-center gap-1"><span class="move-regressed font-medium">▲</span> diverged more</span>
        </span>
      </div>
      <!-- One sentence per line on desktop, so the rule reads as two clean
           statements rather than a paragraph wrapping mid-clause; on narrow
           screens the spans flow naturally. -->
      <p>
        <span class="sm:block">Letters follow divergence over the whole suite, in each target's closest region; A+ means zero failing tests there, not a rounded 0.0%.</span>
        <span class="sm:block" @text="$data.coverageShareSentence"></span>
      </p>
    </div>
  </div>

  </details>

  <!-- Biggest movers since the previous run -->
  <div webc:if="$data.conformance.movers.length" class="mb-6 flex flex-wrap items-center gap-2 text-sm">
    <span class="text-zinc-500 dark:text-zinc-400">Biggest moves:</span>
    <a
      webc:for="m of $data.conformance.movers"
      :href="'/targets/' + m.slug"
      :class="'inline-flex items-center gap-1.5 rounded-full border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/[0.03] px-3 py-1 hover:border-brand-300 dark:hover:border-brand-500/40 transition-colors move-' + m.state">
      <span class="text-zinc-700 dark:text-zinc-200 font-medium" @text="m.display"></span>
      <span aria-hidden="true" @text="m.arrow"></span>
      <span class="font-mono tnum text-xs" aria-hidden="true" @text="m.deltaReading"></span>
      <span class="sr-only" @text="m.label"></span>
    </a>
  </div>

  <!-- On a run where the suite grew, the biggest moves partly reflect new tests
       rather than changed behaviour, so caveat them rather than read as drama. -->
  <p webc:if="$data.conformance.movers.length && $data.conformance.latest.suiteGrew" class="-mt-3 mb-6 text-xs text-zinc-500 dark:text-zinc-400 max-w-2xl">
    <span @text="formatNumber($data.conformance.latest.suiteGrowth)"></span> tests added this run may affect movement. The
    <a :href="'/runs/' + $data.conformance.latest.id" class="underline hover:text-brand-700 dark:hover:text-brand-300">run page</a> has the detail.
  </p>

  <ol class="standings-list space-y-3">
    <!-- Builds of a project render inside their parent's row, so skip them
         here. They stay in `standings` because every other surface - the target
         index, the per-target pages, the JSON endpoints - needs the full list.
         The baseline is skipped too: it renders as the control strip above,
         because the yardstick is not a competitor and does not wear a grade.
         The visible consequence is deliberate - the top card is now the
         highest-graded engine, which today is the board author's own, with
         the disclosure sitting on the card. -->
    <!-- `isParent` when the model was built this run, the slug otherwise. The
         committed history fallback is serialised from an earlier build and
         carries no flag, so keying on it alone emptied the board entirely on
         every fallback render - which is the path PR CI and any failed fetch
         take. The fallback keeps the old reading, which is what it had anyway. -->
    <standings-row webc:for="row of $data.conformance.latest.standings" webc:if="standsForProject(row) && !row.baseline" :row="row"></standings-row>
  </ol>
</section>
