<script webc:setup>
  // One encoding per mark, the same split as the headline row: the bar draws
  // the tier's coverage in neutral grey, and the divergence figure carries the
  // band colour. The bar used to carry both at once - length as coverage,
  // colour as divergence - which is the dual encoding the board retired.
  // Banded by the same grader the letters use, so a tier figure and the board's
  // colour boundaries cannot drift apart. Coverage is pinned at 100 because a
  // tier bar colours by divergence alone: the coverage cap belongs to the row's
  // letter, not to the colour of one tier's figure. These boundaries were three
  // literals here (5 and 25), which a criteria change would have left behind.
  function figClass(v) { return "fig-" + gradeOf(v, 100).band; }
  function widthPct(v) { return (v == null ? 0 : v) + "%"; }
  // The tier's product name and one-line meaning, so "Tier 2" is not a bare
  // ordinal on the one surface where a reader meets it first. Mirrors the
  // TIERS vocabulary the data endpoints publish.
  const TIER_META = {
    "Tier 1": { label: "Core", description: "The operations roughly 90% of DynamoDB users rely on: CRUD, queries, scans, batch operations, GSIs, UpdateTable." },
    "Tier 2": { label: "Complete", description: "Documented but less common features: transactions, PartiQL, LSIs, TTL, streams, tags, vector search." },
    "Tier 3": { label: "Strict", description: "Validation ordering, error behaviour, limits, and legacy API shapes." },
  };
  function tierTitle(name) { return TIER_META[name]?.description ?? ""; }
  function tierLabel(name) { return TIER_META[name] ? name + " · " + TIER_META[name].label : name; }
</script>
<div class="tier-metric">
  <div class="flex items-center justify-between gap-2 mb-1">
    <span class="text-xs uppercase tracking-wide text-zinc-500 dark:text-zinc-400 cursor-help" :title="tierTitle(name)" @text="tierLabel(name)"></span>
    <!-- The figure is named and coloured by its band; a bare right-aligned
         percentage read as anything the reader expected it to be. -->
    <span class="text-xs font-mono tnum whitespace-nowrap" :class="figClass(tier.divergenceValue)">
      <span @text="tier.divergence"></span><span class="font-sans text-zinc-500 dark:text-zinc-400"> diverges</span>
    </span>
  </div>
  <!-- The tier's coverage as a figure, not only as the bar's length. Divergence
       is paired with a number everywhere else it is published, and a tier whose
       coverage lives solely in a bar is the one place a thin surface stops being
       stated: Dynalite's Tier 2 diverges on 14.1%, which reads unremarkable
       until you know it attempts a fifth of the tier. -->
  <div class="mb-1 flex items-baseline justify-between gap-2 text-xs text-zinc-500 dark:text-zinc-400">
    <span class="font-mono tnum"><span @text="tier.coverage"></span> covered</span>
    <span webc:if="tier.skipped" class="tnum" @text="tier.skipped + ' unsupported'"></span>
  </div>
  <!-- Fails over what the tier actually attempts, on the detail pages only. A
       tier divergence is over the whole tier, so a thinly-attempted tier reads
       mild: Dynalite's Tier 2 shows 14.1% while getting 28 of the 40 tests it
       attempts wrong. -->
  <div webc:if="detail && tier.failed" class="mb-1 text-xs text-zinc-500 dark:text-zinc-400 tnum"
    @text="tier.failed + ' of ' + (tier.passed + tier.failed) + ' attempted'"></div>
  <!-- The value this meter DRAWS is coverage, so that is what it reports.
       Reporting divergence here while rendering coverage as the width left
       assistive tech a number that contradicted the bar beside it, and
       disagreed with the two sibling meters. The label states both. -->
  <div
    class="h-1.5 rounded-full bg-zinc-200 dark:bg-white/10 overflow-hidden"
    role="meter"
    aria-valuemin="0"
    aria-valuemax="100"
    :aria-valuenow="tier.coverageValue == null ? 0 : tier.coverageValue"
    :aria-label="display + ' ' + name + ': diverges on ' + tier.divergence + ', covers ' + tier.coverage">
    <div class="h-full rounded-full bg-zinc-400 dark:bg-zinc-400/80" :style="'width:' + widthPct(tier.coverageValue)"></div>
  </div>
</div>
