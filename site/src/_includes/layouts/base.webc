<!doctype html>
<html lang="en-GB" class="scroll-smooth">
  <head>
    <script webc:keep>
      try {
        document.documentElement.classList.toggle('dark', localStorage.theme !== 'light');
      } catch {
        document.documentElement.classList.add('dark');
      }
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin webc:keep>
    <link rel="stylesheet" href="/css/style.css" webc:keep>

    <title @html="pageTitle(meta.title, site.title)"></title>
    <meta name="description" :content="meta.description || site.description" />
    <meta name="author" content="Martin Hicks" />
    <link rel="author" href="https://martinhicks.dev" />

    <link rel="canonical" :href="site.url + (this.page.url === '' ? '/' : this.page.url)" />
    <link rel="alternate" type="application/atom+xml" title="Parity Suite - Runs" :href="site.url + '/feed.xml'" />

    <meta property="og:site_name" :content="site.title + ' - ' + site.descriptor" />
    <meta property="og:title" :content="meta.title || site.title" />
    <meta property="og:description" :content="meta.description || site.description" />
    <meta property="og:url" :content="site.url + this.page.url" />
    <meta property="og:type" :content="meta.ogType || 'website'" />
    <meta property="og:image" :content="site.url + site.ogImage" />
    <meta property="og:image:alt" :content="site.ogImageAlt" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" :content="meta.title || site.title" />
    <meta name="twitter:description" :content="meta.description || site.description" />
    <meta name="twitter:image" :content="site.url + site.ogImage" />
    <meta name="twitter:image:alt" :content="site.ogImageAlt" />
    <meta name="twitter:creator" :content="site.twitterCreator" />

    <meta name="theme-color" content="#f0fdfa" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#101619" media="(prefers-color-scheme: dark)">

    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
    <link rel="apple-touch-icon" href="/images/logo.svg">

    <meta name="robots" :content="meta.robots || 'index, follow'" />

    <!-- Altino: cookieless, no consent banner, honours Do Not Track. Emitted for
         real builds only (src/_data/analytics.js), so `npm run dev` isn't counted.
         The CSP that lets this load lives with the distribution, not here. -->
    <script webc:if="analytics.enabled" async src="https://tracker.altino.dev/v1/t.js" data-site="01KY71Z0EPM7NBAEBFNRTK2S28" webc:keep></script>

    <script webc:keep type="application/ld+json" @html="personJsonLd(this)"></script>
    <script webc:keep type="application/ld+json" @html="publisherJsonLd(this)"></script>
    <script webc:keep type="application/ld+json" @html="websiteJsonLd(this)"></script>
    <script webc:keep type="application/ld+json" @html="webpageJsonLd(this)"></script>
    <script webc:keep webc:if="this.breadcrumbs" type="application/ld+json" @html="breadcrumbJsonLd(this)"></script>
    <script webc:keep webc:if="this.page.url === '/'" type="application/ld+json" @html="datasetJsonLd(this)"></script>

    <style @raw="getBundle('css')" webc:keep></style>
  </head>

  <body class="bg-white dark:bg-surface-950 text-zinc-800 dark:text-zinc-100 antialiased transition-colors">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:top-3 focus:left-3 focus:rounded-lg focus:bg-brand-700 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white">Skip to content</a>
    <div class="flex flex-col min-h-screen">
      <site-header></site-header>
      <main id="main" class="flex-1" @html="content"></main>
      <site-footer></site-footer>
    </div>
    <script webc:keep>
      // Close popover/menu <details> (marked data-dismiss) on an outside click
      // or Escape. Inline disclosures without the attribute stay open.
      document.addEventListener('click', function (e) {
        document.querySelectorAll('details[data-dismiss][open]').forEach(function (d) {
          if (!d.contains(e.target)) d.open = false;
        });
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          document.querySelectorAll('details[data-dismiss][open]').forEach(function (d) {
            const restoreFocus = d.contains(document.activeElement);
            d.open = false;
            if (restoreFocus) d.querySelector('summary')?.focus();
          });
        }
      });
    </script>
    <site-interactions></site-interactions>
    <script @raw="getBundle('js')" webc:keep></script>
  </body>
</html>
