---js
{
  layout: "layouts/base.webc",
  meta: {
    title: "Runs",
    description: "Every recorded conformance run, newest first. Step back through time to see how each DynamoDB emulator's scores have shifted.",
  },
  // The index lists every run newest-first, so its freshness is the latest run
  // date, not this file's git date. Keeps the sitemap <lastmod> honest.
  eleventyComputed: {
    lastmod: (data) => data.conformance?.latest?.date,
  },
}
---
<section class="runs-page max-w-6xl mx-auto px-6 py-12">
  <p class="eyebrow">Measurement history</p>
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white mb-2">Runs</h1>
  <p class="text-zinc-600 dark:text-zinc-300 mb-8 max-w-2xl">
    Every recorded run, newest first. A run groups every result that shares a date; targets not re-tested that day are carried forward. Open one for the full results.
  </p>
  <ol class="run-list">
    <li webc:for="r of $data.conformance.runs" class="group relative flex items-center justify-between gap-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/[0.03] p-4 sm:p-5 hover:border-brand-300 dark:hover:border-brand-500/40 transition-colors">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <!-- Stretched link: the whole row navigates, but the change-note icon
               beside the date sits above it (z-10) so it stays clickable. -->
          <a :href="'/runs/' + r.id" class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-700 dark:group-hover:text-brand-300 after:absolute after:inset-0 after:rounded-xl">
            <time class="block" :datetime="r.date" @text="dateLabel(r.date)"></time>
          </a>
          <div webc:if="$data.changelog.byDate[r.date]" class="relative z-10 leading-none">
            <change-note :entry="$data.changelog.byDate[r.date]"></change-note>
          </div>
        </div>
        <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5" @text="r.emulatorCount + ' emulators'"></div>
      </div>
      <div class="text-right shrink-0">
        <div class="text-xs text-zinc-500 dark:text-zinc-400">Suite size</div>
        <div class="text-sm font-medium text-zinc-800 dark:text-zinc-200 whitespace-nowrap">
          <span class="font-mono tnum" @text="formatNumber(r.suiteSize)"></span> tests<span
            webc:if="r.suiteGrowth"
            class="ml-1.5 inline-flex items-center rounded-full bg-zinc-200/70 dark:bg-white/10 px-1.5 py-0.5 text-[0.7rem] font-medium tnum text-zinc-600 dark:text-zinc-300"
            :title="'grew from ' + formatNumber(r.prevSuiteSize) + ' tests the previous run'"
            @text="(r.suiteGrowth > 0 ? '+' : '') + formatNumber(r.suiteGrowth)"></span>
        </div>
      </div>
    </li>
  </ol>
</section>
