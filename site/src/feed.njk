---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Parity Suite - Runs</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{{ conformance.latest.startTime | isoDateTime }}</updated>
  <author><name>Martin Hicks</name><uri>https://martinhicks.dev</uri></author>
  {%- for r in conformance.runs %}
  <entry>
    <title>Conformance run {{ r.id }}</title>
    <link href="{{ site.url }}/runs/{{ r.id }}"/>
    <id>{{ site.url }}/runs/{{ r.id }}</id>
    <updated>{{ r.startTime | isoDateTime }}</updated>
    {#-
      A run predating the grading criteria says so, rather than just omitting
      the letter. A feed is read one entry at a time, so a missing clause is
      indistinguishable from a field that failed to populate - and the two
      figures are published either way, which is the point the sentence makes.
      /data/runs.json carries the same fact as `gradedUnderCriteria`.
    -#}
    <category term="{% if r.headline.graded %}graded{% else %}ungraded{% endif %}"/>
    <summary>{{ r.emulatorCount }} emulators scored against live AWS DynamoDB ({{ r.suiteSize | formatNumber }} tests). Closest match: {{ r.headline.topDisplay }}{% if r.headline.graded %} at grade {{ r.headline.topGrade }}{% else %} (no letter: this run predates grading criteria version {{ gradingCriteria.version }}, in effect from {{ gradingCriteria.effectiveLabel }}){% endif %}, diverging on {{ r.headline.topDivergence }} of the suite and covering {{ r.headline.topCoverage }}.</summary>
  </entry>
  {%- endfor %}
</feed>
